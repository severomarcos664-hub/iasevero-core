import { localProvider } from './providers/local'
import type { ProviderRoute } from './orchestrator/routing'

export async function runProvider(
  message: string,
  route?: ProviderRoute
) {
  const provider = route?.provider || 'local'

  if (provider !== 'local') {
    console.warn(
      '[IASevero] provider externo bloqueado:',
      provider
    )

    return await localProvider(message)
  }

  return await localProvider(message)
}
